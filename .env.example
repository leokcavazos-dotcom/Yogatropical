# Local SQLite database (swap for a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the deployed app (used for building absolute links, e.g. in emails)
NEXTAUTH_URL="http://localhost:3000"

# Local file storage for uploaded instructor certifications (outside /public, served via an authenticated route)
UPLOADS_DIR="./uploads"

# Stripe (payments are stubbed until these are set — see README "Payments" section)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
