# Postgres connection string. Locally: run a Postgres container/service and
# point this at it. In production: your host's Postgres URL (Vercel Postgres,
# Neon, Supabase, Railway, etc. all work — the schema has no provider lock-in).
DATABASE_URL="postgresql://user:password@localhost:5432/yogatropical"

# NextAuth / Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the deployed app (used for building absolute links, e.g. in emails)
NEXTAUTH_URL="http://localhost:3000"

# Required when running `next start` (production mode) somewhere other than
# the exact NEXTAUTH_URL host (e.g. behind a proxy, or a different local port).
AUTH_TRUST_HOST="true"

# Instructor certification storage. In production, connect a Vercel Blob store
# to the project (Storage tab, same place as the Postgres database) — it
# auto-injects BLOB_READ_WRITE_TOKEN and uploads switch to it automatically.
# Without that token set, certificates save to local disk instead (fine for
# local dev, but disk storage doesn't survive on serverless hosts like Vercel).
BLOB_READ_WRITE_TOKEN=""
UPLOADS_DIR="./uploads"

# Stripe (payments + instructor payouts stay in a friendly "coming soon"
# state until these are set — see README "Payments")
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From Stripe Dashboard → Developers → Webhooks, the signing secret for the
# endpoint pointed at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Onboarding welcome videos (optional). Point these at an AI-generated video to
# start, then swap in real footage later — no code changes needed either way.
# Leave unset for a designed fallback panel instead of a broken video player.
NEXT_PUBLIC_WELCOME_VIDEO_CLIENT_URL=""
NEXT_PUBLIC_WELCOME_VIDEO_INSTRUCTOR_URL=""


# Live video + class recordings (daily.co). Without a key, rooms fall back to
# the public meet.jit.si test server (calls end after 5 minutes, no recording).
DAILY_API_KEY=""
# Protects the scheduled jobs (/api/cron/purge-recordings, run daily by Vercel,
# and /api/cron/send-reminders, run every 15 minutes by
# .github/workflows/reminders.yml). Any long random text; put the same value in
# Vercel and in GitHub (Settings → Secrets and variables → Actions).
CRON_SECRET=""

# Class reminder emails (resend.com), a day before and about an hour before.
# Without a key, no reminder emails are sent.
RESEND_API_KEY=""
# Optional; the sender must be on a domain verified in Resend.
EMAIL_FROM="Yoga Tropical <reminders@yogatropical.com>"
