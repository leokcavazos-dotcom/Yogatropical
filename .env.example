# Postgres connection string. Locally: run a Postgres container/service and
# point this at it. In production: your host's Postgres URL (Vercel Postgres,
# Neon, Supabase, Railway, etc. all work — the schema has no provider lock-in).
DATABASE_URL="postgresql://user:password@localhost:5432/yogatropical"

# NextAuth / Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the deployed app (used for building absolute links, e.g. in emails)
NEXTAUTH_URL="http://localhost:3000"

# Required when running `next start` (production mode) somewhere other than
# the exact NEXTAUTH_URL host (e.g. behind a proxy, or a different local port).
AUTH_TRUST_HOST="true"

# Local file storage for uploaded instructor certifications (outside /public, served via an authenticated route)
UPLOADS_DIR="./uploads"

# Stripe (the onboarding "add payment method" step stays in a friendly
# "coming soon" state until both of these are set — see README "Payments")
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Onboarding welcome videos (optional). Point these at an AI-generated video to
# start, then swap in real footage later — no code changes needed either way.
# Leave unset for a designed fallback panel instead of a broken video player.
NEXT_PUBLIC_WELCOME_VIDEO_CLIENT_URL=""
NEXT_PUBLIC_WELCOME_VIDEO_INSTRUCTOR_URL=""

# Ad slot on the browse page (optional). Leave unset and nothing renders —
# see README "Ads & other revenue streams".
NEXT_PUBLIC_AD_SLOT_BROWSE_IMAGE_URL=""
NEXT_PUBLIC_AD_SLOT_BROWSE_LINK_URL=""
