generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  INSTRUCTOR
  ADMIN
}

enum ClassMode {
  SCHEDULED
  ON_DEMAND
}

enum DeliveryMethod {
  VIRTUAL
  IN_PERSON
}

enum ClassStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  PAYMENT_FAILED
}

enum CertificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificationKind {
  TEACHING
  CPR
  INSURANCE
}

enum RecordingStatus {
  NOT_RECORDED
  RECORDING
  AVAILABLE
  DELETED
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role              @default(CLIENT)
  guidelinesAcceptedAt DateTime?
  onboardingCompletedAt DateTime?
  phone             String?
  preferredLanguageId String?
  preferredLanguage Language?         @relation("UserPreferredLanguage", fields: [preferredLanguageId], references: [id])
  stripeCustomerId  String?
  photoPath         String?
  emailReminders    Boolean           @default(true)
  locale            String?
  timeZone          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  instructorProfile InstructorProfile?
  clientProfile     ClientProfile?
  classSessions     ClassSession[]    @relation("InstructorSessions")
  enrollments       Enrollment[]      @relation("ClientEnrollments")
  reviewedCertifications Certification[] @relation("CertificationReviewer")
  classAudits       ClassAudit[]      @relation("ClassAuditor")
  safetyAcknowledgments SafetyAcknowledgment[]
}

model SafetyAcknowledgment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  signedName String
  acceptedAt DateTime @default(now())

  @@unique([userId, version])
}

model InstructorProfile {
  id                      String       @id @default(cuid())
  userId                  String       @unique
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String       @default("")
  whyITeach               String       @default("")
  ageGroups               String[]     @default([])
  specialPopulations      String[]     @default([])
  maxStudents             Int?
  isAvailableOnDemand     Boolean      @default(false)
  onDemandDurationMinutes Int?
  onDemandCapacity        Int?
  onDemandPricePerStudent Float?
  isCertified             Boolean      @default(false)
  payoutEmail             String?
  offersInPerson          Boolean      @default(false)
  travelServiceArea       String?
  country                 String?
  inPersonDurationMinutes Int?
  inPersonCapacity        Int?
  inPersonPricePerStudent Float?
  stripeAccountId         String?      @unique
  payoutsEnabled          Boolean      @default(false)
  specialties             Specialty[]  @relation("InstructorSpecialties")
  languages               Language[]   @relation("InstructorLanguages")
  certifications          Certification[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

// Private: visible only to the client, admins, and instructors the client
// has requested or booked (see src/lib/profileAccess.ts).
model ClientProfile {
  id                  String     @id @default(cuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aboutMe             String     @default("")
  whatBringsYou       String     @default("")
  ageRange            String?
  notesForInstructors String     @default("")
  prefersVirtual      Boolean    @default(true)
  prefersInPerson     Boolean    @default(false)
  country             String?
  area                String?
  languages           Language[] @relation("ClientLanguages")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Certification {
  id                  String              @id @default(cuid())
  instructorProfileId String
  instructorProfile   InstructorProfile   @relation(fields: [instructorProfileId], references: [id], onDelete: Cascade)
  kind                CertificationKind   @default(TEACHING)
  fileName            String
  storagePath         String
  status              CertificationStatus @default(PENDING)
  reviewedById        String?
  reviewedBy          User?               @relation("CertificationReviewer", fields: [reviewedById], references: [id])
  reviewNotes         String              @default("")
  submittedAt         DateTime            @default(now())
  reviewedAt          DateTime?
}

model Specialty {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  description   String        @default("")
  instructors   InstructorProfile[] @relation("InstructorSpecialties")
  classSessions ClassSession[]      @relation("ClassSpecialties")
}

model Language {
  id              String              @id @default(cuid())
  name            String              @unique
  instructors     InstructorProfile[] @relation("InstructorLanguages")
  classSessions   ClassSession[]      @relation("ClassLanguages")
  preferringUsers User[]              @relation("UserPreferredLanguage")
  clients         ClientProfile[]     @relation("ClientLanguages")
}

model ClassSession {
  id               String        @id @default(cuid())
  instructorId     String
  instructor       User          @relation("InstructorSessions", fields: [instructorId], references: [id], onDelete: Cascade)
  mode             ClassMode     @default(SCHEDULED)
  deliveryMethod   DeliveryMethod @default(VIRTUAL)
  locationAddress  String?
  title            String
  description      String        @default("")
  startTime        DateTime
  durationMinutes  Int
  capacity         Int?
  pricePerStudent  Float
  status           ClassStatus   @default(OPEN)
  videoRoomSlug    String?       @unique
  recordingStatus  RecordingStatus @default(NOT_RECORDED)
  recordingPath    String?
  recordingExpiresAt DateTime?
  reminderDaySentAt  DateTime?
  reminderHourSentAt DateTime?
  specialties      Specialty[]   @relation("ClassSpecialties")
  languages        Language[]    @relation("ClassLanguages")
  enrollments      Enrollment[]
  audits           ClassAudit[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([startTime])
  @@index([mode, status])
}

model ClassAudit {
  id             String       @id @default(cuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  adminId        String
  admin          User         @relation("ClassAuditor", fields: [adminId], references: [id])
  rating         Int
  notes          String       @default("")
  flagged        Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Enrollment {
  id              String            @id @default(cuid())
  classSessionId  String
  classSession    ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  clientId        String
  client          User              @relation("ClientEnrollments", fields: [clientId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus  @default(PENDING)
  priceCharged    Float
  commissionAmount Float
  requestedAt     DateTime          @default(now())
  respondedAt     DateTime?
  stripePaymentIntentId String?
  paidAt                DateTime?
  refundedAt            DateTime?
  reminderDaySentAt     DateTime?
  reminderHourSentAt    DateTime?

  @@unique([classSessionId, clientId])
}

model PlatformSettings {
  id                     String   @id @default("singleton")
  commissionPercent      Float    @default(10)
  recordingRetentionDays Int      @default(7)
  updatedAt              DateTime @updatedAt
}

enum ProductTier {
  LUXE
  EVERYDAY
  BUDGET
}

enum AdPlacement {
  HOME
  BROWSE
  STORE
}

// Curated affiliate products: we link out, the retailer ships, we may earn a commission.
model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  retailer    String
  url         String
  priceLabel  String      @default("")
  tier        ProductTier
  tags        String[]    @default([])
  imagePath   String?
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, tier])
}

// Admin-managed sponsored banners. One random active ad shows per placement.
model Ad {
  id         String        @id @default(cuid())
  altText    String
  linkUrl    String
  imagePath  String
  placements AdPlacement[]
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
